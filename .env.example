# --- Server ----------------------------------------------------------------
PORT=5000
# development | production
NODE_ENV=development

# Long random text used to sign login cookies. REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=4a6b0acc42f741a4b44a46cac1201e08e4698b982dfd7576d97378c2c77b5c93a489b44f232e0f6bb57933ab7305ba1a

# This email becomes the OWNER when it registers.
# Leave empty and the very first account that registers becomes the owner.
OWNER_EMAIL=

# Fill an empty database with demo categories/products on start (default: true in development, false in production)
# SEED_DEMO=true

# Login cookies are https-only in production. Set false ONLY if you run production over plain http (e.g. a LAN test).
# COOKIE_SECURE=false

# Set true when the site is behind a proxy / load balancer (Render, Railway, Nginx, Cloudflare...)
# TRUST_PROXY=true

# Extra allowed browser origins for write requests (comma separated). Normally not needed.
# ALLOWED_ORIGINS=https://www.example.com
